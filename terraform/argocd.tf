# GitOps inside the cluster (ADR-14). Terraform installs Argo CD and one root
# Application; Argo CD then syncs everything in deploy/ from git and reverts
# manual changes. Terraform passes in only what it alone knows.

data "aws_ecr_repository" "api" {
  name = "${var.project}-api" # terraform/shared: survives the stack being destroyed
}

locals {
  api_env = merge(local.table_env, {
    AWS_REGION         = var.region
    AWS_DEFAULT_REGION = var.region
    QUEUE_URL          = aws_sqs_queue.checkout.url
    DB_HOST            = aws_db_instance.main.address
    DB_NAME            = aws_db_instance.main.db_name
    DB_SECRET_ARN      = aws_db_instance.main.master_user_secret[0].secret_arn
    TOKEN_SECRET_ARN   = aws_secretsmanager_secret.token_key.arn
    HOLD_SECONDS       = tostring(var.hold_seconds)
    WS_URL             = aws_apigatewayv2_stage.live.invoke_url # read by /config.json when the pods serve the site
  })

  root_values = {
    repoURL  = var.gitops_repo_url
    revision = var.gitops_revision
    cluster = {
      name   = aws_eks_cluster.main.name
      region = var.region
      vpcId  = aws_vpc.main.id
    }
    api = {
      enabled        = var.api_image_tag != ""
      image          = { repository = data.aws_ecr_repository.api.repository_url, tag = var.api_image_tag }
      targetGroupArn = aws_lb_target_group.app.arn
      env            = local.api_env
    }
    loki = { bucket = aws_s3_bucket.logs.bucket }
  }

  # Everything Helm and Argo CD need in place first.
  cluster_ready = [
    aws_eks_node_group.main,
    aws_eks_addon.coredns,
    aws_eks_access_policy_association.this,
  ]
}

resource "helm_release" "argocd" {
  name             = "argocd"
  repository       = "https://argoproj.github.io/argo-helm"
  chart            = "argo-cd"
  version          = "10.18.0"
  namespace        = "argocd"
  create_namespace = true
  values           = [file("${path.module}/../deploy/argocd/values.yaml")]
  timeout          = 900

  depends_on = [local.cluster_ready]
}

# Grafana's admin password lives in a Secret Terraform creates: a password
# generated by the chart would change on every Argo CD sync.
resource "kubernetes_namespace_v1" "monitoring" {
  metadata { name = "monitoring" }
  depends_on = [local.cluster_ready]
}

resource "random_password" "grafana_admin" {
  length  = 24
  special = false
}

resource "kubernetes_secret_v1" "grafana_admin" {
  metadata {
    name      = "grafana-admin"
    namespace = kubernetes_namespace_v1.monitoring.metadata[0].name
  }
  data = {
    admin-user     = "admin"
    admin-password = random_password.grafana_admin.result
  }
}

resource "helm_release" "root" {
  name       = "frontrow-root"
  repository = "https://argoproj.github.io/argo-helm"
  chart      = "argocd-apps"
  version    = "2.0.8"
  namespace  = "argocd"

  values = [yamlencode({
    applications = {
      frontrow-root = {
        namespace  = "argocd"
        finalizers = ["resources-finalizer.argocd.argoproj.io"]
        project    = "default"
        source = {
          repoURL        = var.gitops_repo_url
          targetRevision = var.gitops_revision
          path           = "deploy/root"
          helm           = { valuesObject = local.root_values }
        }
        destination = { server = "https://kubernetes.default.svc", namespace = "argocd" }
        syncPolicy  = { automated = { prune = true, selfHeal = true } }
      }
    }
  })]

  depends_on = [
    helm_release.argocd,
    kubernetes_secret_v1.grafana_admin,
    aws_eks_pod_identity_association.this,
    aws_eks_addon.ebs_csi,
    aws_lambda_invocation.seed_inventory, # the API reads seeded inventory
  ]
}
